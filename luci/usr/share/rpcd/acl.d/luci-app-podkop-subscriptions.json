{
  "luci-app-podkop-subscriptions": {
    "description": "Grant access to Podkop Subscriptions LuCI app",
    "read": {
      "file": {
        "/etc/config/podkop": [
          "read"
        ],
        "/etc/config/podkop_subscriptions": [
          "read"
        ],
        "/etc/config/podkop-local-links": [
          "read"
        ],
        "/usr/bin/podkop-sub-updater.py": [
          "exec"
        ],
        "/usr/bin/podkop-sub-cron-sync": [
          "exec"
        ],
        "/usr/bin/podkop-sub-run-now": [
          "exec"
        ]
      },
      "uci": [
        "podkop",
        "podkop_subscriptions"
      ],
      "ubus": {
        "service": [
          "list"
        ]
      }
    },
    "write": {
      "file": {
        "/etc/config/podkop_subscriptions": [
          "write"
        ],
        "/etc/config/podkop-local-links": [
          "write"
        ]
      },
      "uci": [
        "podkop_subscriptions"
      ]
    }
  }
}
