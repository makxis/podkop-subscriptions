#!/bin/sh

. /lib/functions.sh

CRON_FILE="/etc/crontabs/root"
SUB_CFG="/etc/config/podkop_subscriptions"
UPDATER_TAG="# podkop-sub-updater"
HEALTH_TAG="# podkop-sub-health"
CATCHUP_TAG="# podkop-sub-catchup"
TMP_FILE="${CRON_FILE}.tmp.$$"

# LuCI and the procd config trigger may invoke synchronization almost
# simultaneously. Use a kernel-backed flock, held by a tiny Python parent,
# so lock acquisition is atomic and a crashed process cannot leave a stale
# mkdir/PID lock behind. The child shell inherits the locked descriptor.
if [ "${PODKOP_CRON_SYNC_LOCKED:-0}" != "1" ]; then
  exec python3 - "$0" "$@" <<'PYLOCK'
import fcntl
import os
import subprocess
import sys
import time

LOCK_PATH = "/tmp/podkop-sub-cron-sync.flock"
WAIT_SECONDS = 30.0
POLL_SECONDS = 0.2

fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
deadline = time.monotonic() + WAIT_SECONDS

while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except BlockingIOError:
        if time.monotonic() >= deadline:
            print(
                "Cron synchronization lock remained busy for 30 seconds.",
                file=sys.stderr,
            )
            os.close(fd)
            raise SystemExit(1)
        time.sleep(POLL_SECONDS)

env = os.environ.copy()
env["PODKOP_CRON_SYNC_LOCKED"] = "1"

try:
    rc = subprocess.call(
        ["/bin/sh", sys.argv[1], *sys.argv[2:]],
        env=env,
        pass_fds=(fd,),
    )
finally:
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)

raise SystemExit(rc)
PYLOCK
fi

cleanup() {
  rm -f "$TMP_FILE" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

touch "$CRON_FILE"
chmod 0600 "$CRON_FILE" 2>/dev/null || true

# Remove only lines managed by this project. Native Podkop list_update stays intact.
grep -v "$UPDATER_TAG" "$CRON_FILE" \
  | grep -v "$HEALTH_TAG" \
  | grep -v "$CATCHUP_TAG" > "$TMP_FILE" || true
mv "$TMP_FILE" "$CRON_FILE"
chmod 0600 "$CRON_FILE" 2>/dev/null || true

if [ ! -f "$SUB_CFG" ]; then
  /etc/init.d/cron enable >/dev/null 2>&1 || true
  /etc/init.d/cron restart >/dev/null 2>&1 || true
  echo "Subscriptions config not found: $SUB_CFG"
  exit 0
fi

GROUPS_COUNT=0
SCHEDULES_COUNT=0

count_group() {
  local section="$1"
  local enabled
  config_get enabled "$section" enabled "1"
  [ "$enabled" = "1" ] && GROUPS_COUNT=$((GROUPS_COUNT + 1))
}

add_schedule() {
  local section="$1"
  local enabled hour minute jitter force force_arg cmd

  config_get enabled "$section" enabled "1"
  [ "$enabled" = "1" ] || return 0

  config_get hour "$section" hour ""
  config_get minute "$section" minute "0"
  config_get jitter "$section" jitter "0"
  config_get force "$section" force "0"

  case "$hour" in ''|*[!0-9]*) return 0 ;; esac
  case "$minute" in ''|*[!0-9]*) minute="0" ;; esac
  case "$jitter" in ''|*[!0-9]*) jitter="0" ;; esac

  [ "$hour" -ge 0 ] 2>/dev/null || return 0
  [ "$hour" -le 23 ] 2>/dev/null || return 0
  [ "$minute" -ge 0 ] 2>/dev/null || minute="0"
  [ "$minute" -le 59 ] 2>/dev/null || minute="0"

  force_arg=""
  [ "$force" = "1" ] && force_arg="--force"

  if [ "$jitter" -gt 0 ] 2>/dev/null; then
    cmd="sleep \$(awk 'BEGIN{srand(); print int(rand()*$jitter)}') && /usr/bin/podkop-sub-updater.py --subs $SUB_CFG --config /etc/config/podkop $force_arg 2>&1 | logger -t podkop-updater-cron"
  else
    cmd="/usr/bin/podkop-sub-updater.py --subs $SUB_CFG --config /etc/config/podkop $force_arg 2>&1 | logger -t podkop-updater-cron"
  fi

  echo "$minute $hour * * * $cmd $UPDATER_TAG:$section" >> "$CRON_FILE"
  SCHEDULES_COUNT=$((SCHEDULES_COUNT + 1))
}

add_hourly_observer() {
  echo "0 * * * * /usr/bin/podkop-sub-updater.py --observe-only --config /etc/config/podkop 2>&1 | logger -t podkop-sub-health $HEALTH_TAG:auto" >> "$CRON_FILE"
}

add_catchup_jobs() {
  echo "@reboot sleep 300 && /usr/bin/podkop-sub-updater.py --catch-up --subs $SUB_CFG --config /etc/config/podkop 2>&1 | logger -t podkop-sub-catchup $CATCHUP_TAG:boot" >> "$CRON_FILE"
  echo "*/30 * * * * /usr/bin/podkop-sub-updater.py --catch-up-retry --subs $SUB_CFG --config /etc/config/podkop 2>&1 | logger -t podkop-sub-catchup $CATCHUP_TAG:retry" >> "$CRON_FILE"
}

config_load podkop_subscriptions
config_foreach count_group subscription_group

if [ "$GROUPS_COUNT" -eq 0 ]; then
  /etc/init.d/cron enable >/dev/null 2>&1 || true
  /etc/init.d/cron restart >/dev/null 2>&1 || true
  echo "No enabled subscription groups. Cron disabled."
  exit 0
fi

add_hourly_observer
add_catchup_jobs
config_foreach add_schedule subscription_schedule

/etc/init.d/cron enable >/dev/null 2>&1 || true
/etc/init.d/cron restart >/dev/null 2>&1 || true

if [ "$SCHEDULES_COUNT" -eq 0 ]; then
  echo "No enabled subscription schedules. Only hourly health observer and catch-up jobs were enabled:"
  grep "$HEALTH_TAG\|$CATCHUP_TAG" "$CRON_FILE" || true
else
  echo "Cron updated:"
  grep "$HEALTH_TAG\|$UPDATER_TAG\|$CATCHUP_TAG" "$CRON_FILE" || true
fi
