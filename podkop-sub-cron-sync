#!/bin/sh

. /lib/functions.sh

CRON_FILE="/etc/crontabs/root"
TAG="# podkop-sub-updater"
UPDATER="/usr/bin/podkop-sub-updater.py"

touch "$CRON_FILE"
TMP_FILE="${CRON_FILE}.tmp.$$"

# Удаляем и новые управляемые задания, и старые ручные строки updater'а без тега.
# При этом штатный podkop list_update не трогаем.
grep -v "$TAG" "$CRON_FILE" | grep -v "$UPDATER" > "$TMP_FILE" || true
mv "$TMP_FILE" "$CRON_FILE"

GROUPS_COUNT=0
SCHEDULES_COUNT=0

count_group() {
  local section="$1"
  local enabled

  config_get enabled "$section" enabled "1"
  [ "$enabled" = "1" ] && GROUPS_COUNT=$((GROUPS_COUNT + 1))
}

add_schedule() {
  local section="$1"
  local enabled hour minute jitter force force_arg cmd

  config_get enabled "$section" enabled "1"
  [ "$enabled" = "1" ] || return 0

  config_get hour "$section" hour ""
  config_get minute "$section" minute "0"
  config_get jitter "$section" jitter "0"
  config_get force "$section" force "0"

  case "$hour" in ''|*[!0-9]*) return 0 ;; esac
  case "$minute" in ''|*[!0-9]*) minute="0" ;; esac
  case "$jitter" in ''|*[!0-9]*) jitter="0" ;; esac

  [ "$hour" -ge 0 ] 2>/dev/null || return 0
  [ "$hour" -le 23 ] 2>/dev/null || return 0
  [ "$minute" -ge 0 ] 2>/dev/null || minute="0"
  [ "$minute" -le 59 ] 2>/dev/null || minute="0"

  force_arg=""
  [ "$force" = "1" ] && force_arg="--force"

  if [ "$jitter" -gt 0 ] 2>/dev/null; then
    cmd="sleep \$(awk 'BEGIN{srand(); print int(rand()*$jitter)}') && $UPDATER --subs /etc/config/podkop --config /etc/config/podkop $force_arg 2>&1 | logger -t podkop-updater-cron"
  else
    cmd="$UPDATER --subs /etc/config/podkop --config /etc/config/podkop $force_arg 2>&1 | logger -t podkop-updater-cron"
  fi

  echo "$minute $hour * * * $cmd $TAG:$section" >> "$CRON_FILE"
  SCHEDULES_COUNT=$((SCHEDULES_COUNT + 1))
}

config_load podkop
config_foreach count_group subscription_group

if [ "$GROUPS_COUNT" -eq 0 ]; then
  /etc/init.d/cron enable >/dev/null 2>&1
  /etc/init.d/cron restart >/dev/null 2>&1
  echo "No enabled subscription groups. Updater cron jobs removed."
  exit 0
fi

config_foreach add_schedule subscription_schedule

/etc/init.d/cron enable >/dev/null 2>&1
/etc/init.d/cron restart >/dev/null 2>&1

if [ "$SCHEDULES_COUNT" -eq 0 ]; then
  echo "No enabled subscription schedules. Updater cron jobs removed."
else
  echo "Cron updated:"
  grep "$TAG" "$CRON_FILE" || true
fi
