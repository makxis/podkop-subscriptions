# Отпечаток клиента: заголовки, с которыми роутер ходит за подпиской.
# Панель по ним решает, что перед ней настоящее приложение, поэтому важны и
# регистр имён, и порядок следования — list сохраняет и то, и другое.
# Вставить сюда можно набор, снятый с реального клиента.
#
# X-HWID — обычная строка блока. Значение {hwid} означает «сгенерировать
# персональный при первом запуске и записать сюда вместо placeholder-а».
# Менять его потом не нужно: для панели смена X-HWID выглядит как новое
# устройство, а лимит устройств на подписку есть у многих панелей. Если такой
# лимит мешает, скопируйте уже сгенерированное значение с первого роутера на
# остальные вручную.
config fingerprint 'default'
    option enabled '1'
    list header 'User-agent: v2raytun/android'
    list header 'X-HWID: {hwid}'
    list header 'X-Device-OS: Android'
    list header 'X-Ver-OS: Android 11'
    list header 'X-Device-Model: OnePlus MT2110'
    list header 'X-App-Version: 5.25.81'

config subscription_group 'main'
    option enabled '1'
    option target_section 'main'
    # Пусто или отсутствует — встроенный профиль, как было до появления секции.
    option fingerprint 'default'
    list source 'https://example.com/subscription'
    # Домен узла с несколькими A-записями превращается в набор ключей по
    # одному на адрес, плюс исходный доменный. Нужно, чтобы URLTest выбирал
    # конкретный быстрый сервер, а не тот, что вернул DNS.
    option expand_domain_ips '0'
    # Как часто перезамерять, какой профиль отпечатка выгоднее на этом
    # источнике. Первый замер делается всегда, дальше не чаще этого срока.
    # 0 — замерить один раз и больше не трогать.
    option fingerprint_probe_days '7'
    option use_local_links '1'
    option regex ''
    option match_mode 'ifnotmatch'
    option on_empty 'skip'
    option proxy_type 'urltest'
    option max_links '50'
    option max_latency_ms '500'
    option force_cleanup '0'
    option dedupe_sni_rotation '1'

config subscription_schedule 'main_0300'
    option enabled '1'
    option hour '3'
    option minute '0'
    option jitter '1800'
    option force '0'
